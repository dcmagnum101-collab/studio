rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow any authenticated user to read and write their own data.
    // This is a robust rule for a private, single-user application.
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Global fallback for initial setup/private use
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
