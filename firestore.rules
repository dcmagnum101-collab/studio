rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Contacts Collection
      match /contacts/{contactId} {
        allow read, write: if isOwner(userId);
        
        // Activity Logs sub-collection
        match /activityLogs/{logId} {
          allow read, write: if isOwner(userId);
        }
      }

      // Tasks Collection
      match /tasks/{taskId} {
        allow read, write: if isOwner(userId);
      }

      // Quota and Stats (Daily/Monthly)
      match /email_quota/{date} {
        allow read, write: if isOwner(userId);
      }
      match /rapidapi_quota/{month} {
        allow read, write: if isOwner(userId);
      }

      // Audit Logs (Append-only for security)
      match /ai_usage/{usageId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update, delete: if false; // Immutable audit log
      }
      match /outreach_log/{logId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update, delete: if false; // Immutable audit log
      }

      // Other user-specific data
      match /{allPaths=**} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}