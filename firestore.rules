
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Standard secure user data ownership
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Explicitly allow all subcollections for the owner
      match /{allPaths=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Support for specific administrative access if required
    match /{document=**} {
      allow read, write: if request.auth != null && (request.auth.uid == 'RZ0vqKV5BgZjJmWGwF9npV08TDd2' || request.auth.uid == 'HoJPC9XqooWR7ahPcejrnjXUpyE2');
    }
  }
}
