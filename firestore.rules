rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      // Allow the owner full access to their document and subcollections
      allow read, write: if isOwner(userId);

      match /contacts/{contactId} {
        // Allow public creation of contacts from Open House Sign-ins
        // This bypasses auth but is restricted to specific guestbook data
        allow create: if request.resource.data.archagent_source == 'open_house';
        allow read, update, delete: if isOwner(userId);
      }
      
      match /{allPaths=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Collection Group Rules - Scoped by Path Segment UID
    // path[1] matches the userId in /users/{userId}/contacts/...
    
    match /{path=**}/sms_thread/{msgId} {
      allow read, write: if isSignedIn() && path[1] == request.auth.uid;
    }

    match /{path=**}/activityLogs/{logId} {
      allow read, write: if isSignedIn() && path[1] == request.auth.uid;
    }

    match /{path=**}/tasks/{taskId} {
      allow read, write: if isSignedIn() && path[1] == request.auth.uid;
    }

    // Public Open House Collection
    match /openHouses/{ohId} {
      allow read: if true; // Public can see event details (address, etc.)
      allow create, update, delete: if isSignedIn(); // Only agents can manage OH events
      
      match /signins/{signinId} {
        allow create: if true; // Anyone can sign in at the event
        allow read: if isSignedIn(); // Only agents can see visitor lists
      }
    }
  }
}