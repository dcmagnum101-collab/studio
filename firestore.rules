rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to access their own document and all subcollections recursively
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Explicitly allow access to the user document itself
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}