rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * Monica AI Hub - Simplified Security Rules
     * 
     * Grants full access to any document or subcollection under /users/{userId}
     * as long as the authenticated user's UID matches the userId in the path.
     */
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    /** Deny all other access by default */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}