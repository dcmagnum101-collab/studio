rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Secure per-user data access: Users can only access documents within their own user folder
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Fallback for general access if needed, though scoped above is preferred
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == 'RZ0vqKV5BgZjJmWGwF9npV08TDd2';
    }
  }
}