rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Robust per-user security model
    // This allows the authenticated user full access to their own profile and all subcollections
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Explicitly allow the user to read/write their top-level user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}