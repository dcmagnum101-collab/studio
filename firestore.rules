rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Monica AI Hub Security Rules
     * 
     * Core Philosophy:
     * Strict user-ownership model. Users have full access to their own document 
     * and any data nested beneath it.
     */

    // --- Helper Functions ---

    /** Checks if the request is from a signed-in user. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** Checks if the authenticated user matches the provided userId. */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Collection Rules ---

    /** 
     * User Document and all nested subcollections.
     * This covers /users/{userId}/tasks, /users/{userId}/contacts, etc.
     */
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    /** Global Deny for everything else */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}