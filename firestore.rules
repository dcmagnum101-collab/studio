rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /contacts/{contactId} {
        // Allow public creation of contacts from Open House Sign-ins
        allow create: if request.resource.data.archagent_source == 'open_house';
        allow read, update, delete: if isOwner(userId);
        
        match /activityLogs/{logId} {
          allow read, write: if isOwner(userId);
        }

        match /sms_thread/{msgId} {
          allow read, write: if isOwner(userId);
        }
      }

      match /tasks/{taskId} { allow read, write: if isOwner(userId); }
      match /email_quota/{date} { allow read, write: if isOwner(userId); }
      match /rapidapi_quota/{month} { allow read, write: if isOwner(userId); }
      
      match /{allPaths=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Collection Group Rules for Unified Activity and Messaging
    // These must be outside specific path roots to apply to collectionGroup queries
    match /{path=**}/activityLogs/{logId} {
      allow read: if isSignedIn() && (resource == null || resource.data.ownerId == request.auth.uid);
    }

    match /{path=**}/sms_thread/{msgId} {
      allow read: if isSignedIn() && (resource == null || resource.data.ownerId == request.auth.uid);
    }

    // Public Open House Collection
    match /openHouses/{ohId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn(); // Only agents can manage OH events
      
      match /signins/{signinId} {
        allow create: if true; // Anyone can sign in
        allow read: if isSignedIn(); // Only agents can see visitor lists
      }
    }
  }
}