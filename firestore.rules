rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Private app for a single user: allow any authenticated user to access all data.
    // This provides a frictionless experience for 1-user apps while keeping data private from the public.
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}