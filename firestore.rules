rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Monica AI Hub Security Rules
     * 
     * Core Philosophy:
     * This ruleset enforces a strict user-ownership model where all data is private by default. 
     * Access is granted based on the user's authenticated UID matching the path's userId wildcard.
     */

    // --- Helper Functions ---

    /** Checks if the request is from a signed-in user. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** Checks if the authenticated user matches the provided userId. */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** Checks if the user is the owner and the document exists (for updates/deletes). */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /** Validates that the ownerId field in the new data matches the path. */
    function isValidOwnerField(userId) {
      return request.resource.data.ownerId == userId;
    }

    /** Ensures that the ownerId field cannot be changed during an update. */
    function isOwnerImmutable() {
      return request.resource.data.ownerId == resource.data.ownerId;
    }

    // --- Collection Rules ---

    /** Master contact records. */
    match /users/{userId}/contacts/{contactId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidOwnerField(userId);
      allow update: if isExistingOwner(userId) && isOwnerImmutable();
      allow delete: if isExistingOwner(userId);

      /** Interaction history for a contact. */
      match /activityLogs/{logId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidOwnerField(userId);
        allow update: if isExistingOwner(userId) && isOwnerImmutable();
        allow delete: if isExistingOwner(userId);
      }
      
      // Supporting legacy log paths
      match /callLogs/{logId} { allow read, write: if isOwner(userId); }
      match /emailLogs/{logId} { allow read, write: if isOwner(userId); }
      match /smsLogs/{logId} { allow read, write: if isOwner(userId); }
    }

    /** CRM tasks. */
    match /users/{userId}/tasks/{taskId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidOwnerField(userId);
      allow update: if isExistingOwner(userId) && isOwnerImmutable();
      allow delete: if isExistingOwner(userId);
    }

    /** Scheduled events. */
    match /users/{userId}/appointments/{appointmentId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidOwnerField(userId);
      allow update: if isExistingOwner(userId) && isOwnerImmutable();
      allow delete: if isExistingOwner(userId);
    }

    /** Saved geographic prospecting zones. */
    match /users/{userId}/farmZones/{zoneId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidOwnerField(userId);
      allow update: if isExistingOwner(userId) && isOwnerImmutable();
      allow delete: if isExistingOwner(userId);
    }

    /** Open house event records. */
    match /users/{userId}/openHouses/{eventId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidOwnerField(userId);
      allow update: if isExistingOwner(userId) && isOwnerImmutable();
      allow delete: if isExistingOwner(userId);
    }

    /** Daily AI-generated briefing records. */
    match /users/{userId}/morningBriefings/{briefingId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidOwnerField(userId);
      allow update: if isExistingOwner(userId) && isOwnerImmutable();
      allow delete: if isExistingOwner(userId);
    }

    /** Lead sources integration. */
    match /users/{userId}/leadSources/{leadSourceId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidOwnerField(userId);
      allow update: if isExistingOwner(userId) && isOwnerImmutable();
      allow delete: if isExistingOwner(userId);
    }

    /** Global Deny */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}