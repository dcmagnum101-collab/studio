rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Monica AI Hub - COMPLETELY UNRESTRICTED ACCESS
    // This is a private app for a single user. 
    // Security is disabled to ensure zero friction for all data operations.
    // Timestamp: 2024-03-24T16:00:00Z
    match /{document=**} {
      allow read, write: if true;
    }
  }
}