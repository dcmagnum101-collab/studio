rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * Monica AI Hub - Wide Open Rules
     * 
     * This is a private app for a single user. 
     * Security is disabled to ensure zero friction for data operations.
     */
    match /{document=**} {
      allow read, write: if true;
    }
  }
}