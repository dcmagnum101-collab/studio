
{
  "entities": {
    "Contact": {
      "title": "Contact",
      "description": "A real estate lead with full CRM relationship data.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "phone2": { "type": "string" },
        "propertyAddress": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "zip": { "type": "string" },
        "motivation": { "type": "string" },
        "icpScore": { "type": "number" },
        "pipeline_stage": {
          "type": "string",
          "enum": ["new_lead", "attempted_contact", "conversation_had", "follow_up_scheduled", "appointment_set", "appointment_completed", "listing_agreement_sent", "listed", "under_contract", "closed", "not_interested", "dnc", "long_term_nurture"]
        },
        "ai_urgency": { "type": "string", "enum": ["hot", "warm", "cold", "nurture"] },
        "ai_sentiment": { "type": "string", "enum": ["positive", "neutral", "negative"] },
        "ai_summary": { "type": "string" },
        "ai_next_best_action": { "type": "string" },
        "total_calls": { "type": "number" },
        "total_conversations": { "type": "number" },
        "last_call_date": { "type": "string", "format": "date-time" },
        "estimated_commission": { "type": "number" },
        "archagent_source": {
          "type": "string",
          "enum": ["fsbo", "expired", "frbo", "preforeclosure", "circle_prospect", "recommended", "manual"]
        },
        "archagent_tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "CallLog": {
      "title": "Call Log",
      "description": "Historical record of a voice interaction.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "contact_id": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "duration_seconds": { "type": "number" },
        "outcome": { "type": "string" },
        "transcript": { "type": "string" },
        "summary": { "type": "string" },
        "sentiment": { "type": "string" }
      }
    },
    "Task": {
      "title": "Task",
      "description": "An actionable item or reminder.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "contact_id": { "type": "string" },
        "type": { "type": "string", "enum": ["call", "email", "sms", "appointment", "follow_up", "custom"] },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "priority": { "type": "string", "enum": ["urgent", "high", "normal", "low"] },
        "status": { "type": "string", "enum": ["pending", "completed", "snoozed"] },
        "due_date": { "type": "string", "format": "date-time" }
      }
    },
    "Appointment": {
      "title": "Appointment",
      "description": "A scheduled meeting or consultation.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "contact_id": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "duration_minutes": { "type": "number" },
        "type": { "type": "string" },
        "status": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/contacts/{contactId}": {
      "schema": "Contact",
      "description": "CRM Contact records."
    },
    "/call_logs/{logId}": {
      "schema": "CallLog",
      "description": "Call history."
    },
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "To-do items."
    },
    "/appointments/{apptId}": {
      "schema": "Appointment",
      "description": "Scheduled events."
    }
  }
}
