
{
  "entities": {
    "Contact": {
      "title": "Contact",
      "description": "A real estate lead with full CRM relationship data.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "propertyAddress": { "type": "string" },
        "motivation": { "type": "string" },
        "icpScore": { "type": "number" },
        "pipeline_stage": {
          "type": "string",
          "enum": ["new_lead", "attempted_contact", "conversation_had", "follow_up_scheduled", "appointment_set", "appointment_completed", "listing_agreement_sent", "listed", "under_contract", "closed", "not_interested", "dnc", "long_term_nurture"]
        },
        "ai_urgency": { "type": "string", "enum": ["hot", "warm", "cold", "nurture"] },
        "ai_sentiment": { "type": "string", "enum": ["positive", "neutral", "negative"] },
        "archagent_source": {
          "type": "string",
          "enum": ["fsbo", "expired", "frbo", "preforeclosure", "circle_prospect", "recommended", "manual", "probate", "open_house", "social_capture", "gis_import"]
        },
        "archagent_tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "likely_to_list_score": { "type": "number" },
        "estimated_commission": { "type": "number" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "ProbateLead": {
      "title": "Probate Lead",
      "description": "Legal lead from court filings.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "case_number": { "type": "string" },
        "decedent_name": { "type": "string" },
        "filing_date": { "type": "string", "format": "date" },
        "property_address": { "type": "string" },
        "est_value": { "type": "number" },
        "status": { "type": "string" }
      }
    },
    "OpenHouseEvent": {
      "title": "Open House Event",
      "description": "A scheduled real estate event for sign-ins.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "property_address": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "signin_count": { "type": "number" },
        "seller_count": { "type": "number" }
      }
    },
    "MonicaInsight": {
      "title": "Monica Insight",
      "description": "AI-calculated behavioral insights.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["call_timing", "objections", "vm_performance"] },
        "data": { "type": "object" },
        "generated_at": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/contacts/{contactId}": {
      "schema": "Contact",
      "description": "CRM Contact records."
    },
    "/probate_leads/{leadId}": {
      "schema": "ProbateLead",
      "description": "Court-sourced leads."
    },
    "/open_house_events/{eventId}": {
      "schema": "OpenHouseEvent",
      "description": "Open house event registry."
    },
    "/monica_insights/{insightId}": {
      "schema": "MonicaInsight",
      "description": "AI behavioral intelligence."
    }
  }
}
