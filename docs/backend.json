{
  "entities": {
    "Contact": {
      "title": "Contact",
      "type": "object",
      "description": "Comprehensive prospect profile tracking identity, property, and CRM state.",
      "properties": {
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "propertyAddress": { "type": "string" },
        "pipeline_stage": {
          "type": "string",
          "enum": ["new_lead", "attempted_contact", "conversation_had", "follow_up_scheduled", "appointment_set", "listed", "closed"]
        },
        "icpScore": { "type": "number" },
        "archagent_source": { "type": "string" },
        "ai_summary": { "type": "string" },
        "ai_urgency": { "type": "string", "enum": ["hot", "warm", "cold", "nurture"] },
        "estimated_commission": { "type": "number" },
        "ownerId": { "type": "string" }
      },
      "required": ["firstName", "lastName", "ownerId"]
    },
    "Task": {
      "title": "Task",
      "type": "object",
      "description": "Follow-up actions and reminders.",
      "properties": {
        "contactId": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string", "enum": ["call", "email", "sms", "appointment"] },
        "status": { "type": "string", "enum": ["pending", "completed"] },
        "priority": { "type": "string", "enum": ["urgent", "high", "normal", "low"] },
        "due_date": { "type": "string", "format": "date-time" },
        "ownerId": { "type": "string" }
      }
    },
    "CallLog": {
      "title": "CallLog",
      "type": "object",
      "description": "Record of a specific outreach attempt.",
      "properties": {
        "contactId": { "type": "string" },
        "outcome": { "type": "string" },
        "summary": { "type": "string" },
        "sentiment": { "type": "string" },
        "ownerId": { "type": "string" }
      }
    },
    "FarmZone": {
      "title": "FarmZone",
      "type": "object",
      "description": "Geographic prospecting areas.",
      "properties": {
        "name": { "type": "string" },
        "center_address": { "type": "string" },
        "radius": { "type": "number" },
        "total_contacts": { "type": "number" },
        "ownerId": { "type": "string" }
      }
    },
    "OpenHouseEvent": {
      "title": "OpenHouseEvent",
      "type": "object",
      "description": "Physical event for lead capture.",
      "properties": {
        "address": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "signin_count": { "type": "number" },
        "ownerId": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}/contacts/{contactId}",
        "definition": { "entityName": "Contact", "schema": { "$ref": "#/backend/entities/Contact" }, "description": "Master contact record." }
      },
      {
        "path": "/users/{userId}/tasks/{taskId}",
        "definition": { "entityName": "Task", "schema": { "$ref": "#/backend/entities/Task" }, "description": "Global user tasks." }
      },
      {
        "path": "/users/{userId}/contacts/{contactId}/callLogs/{logId}",
        "definition": { "entityName": "CallLog", "schema": { "$ref": "#/backend/entities/CallLog" }, "description": "Interaction history." }
      },
      {
        "path": "/users/{userId}/farmZones/{zoneId}",
        "definition": { "entityName": "FarmZone", "schema": { "$ref": "#/backend/entities/FarmZone" }, "description": "Prospecting zones." }
      },
      {
        "path": "/users/{userId}/openHouses/{eventId}",
        "definition": { "entityName": "OpenHouseEvent", "schema": { "$ref": "#/backend/entities/OpenHouseEvent" }, "description": "Open house events." }
      }
    ]
  }
}
