{
  "entities": {
    "Contact": {
      "title": "Contact",
      "type": "object",
      "description": "Comprehensive prospect profile tracking identity, property, and CRM state.",
      "properties": {
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "propertyAddress": { "type": "string" },
        "property_type": { "type": "string", "enum": ["single_family", "condo", "multi_family", "townhouse", "other"] },
        "pipeline_stage": {
          "type": "string",
          "enum": ["new_lead", "attempted_contact", "conversation_had", "follow_up_scheduled", "appointment_set", "listed", "closed", "long_term_nurture", "dnc"]
        },
        "icpScore": { "type": "number" },
        "archagent_source": { "type": "string" },
        "archagent_tags": { "type": "array", "items": { "type": "string" } },
        "ai_summary": { "type": "string" },
        "ai_urgency": { "type": "string", "enum": ["hot", "warm", "cold", "nurture"] },
        "ai_sentiment": { "type": "string", "enum": ["positive", "neutral", "negative"] },
        "ai_next_best_action": { "type": "string" },
        "estimated_commission": { "type": "number" },
        "loan_to_value": { "type": "number" },
        "likely_to_list_score": { "type": "number" },
        "likely_to_lead_score": { "type": "number" },
        "likely_to_contact_score": { "type": "number" },
        "motivation": { "type": "string" },
        "sequence_step": { "type": "number" },
        "ownerId": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "trulia_id": { "type": "string" },
        "listing_status": { "type": "string" },
        "source_evidence": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["name", "ownerId"]
    },
    "ProspectingJob": {
      "title": "Prospecting Job",
      "type": "object",
      "properties": {
        "url": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "processing", "completed", "failed"] },
        "created_at": { "type": "string", "format": "date-time" },
        "result_contact_id": { "type": "string" },
        "error": { "type": "string" }
      }
    },
    "LeadSource": {
      "title": "Lead Source Evidence",
      "type": "object",
      "properties": {
        "url": { "type": "string" },
        "extracted_data": { "type": "object" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/users/{userId}/contacts/{contactId}": {
      "schema": { "$ref": "#/backend/entities/Contact" },
      "description": "Master contact records."
    },
    "/users/{userId}/prospecting_jobs/{jobId}": {
      "schema": { "$ref": "#/backend/entities/ProspectingJob" },
      "description": "Background jobs for URL enrichment."
    },
    "/users/{userId}/lead_sources/{sourceId}": {
      "schema": { "$ref": "#/backend/entities/LeadSource" },
      "description": "Historical evidence for lead origins."
    }
  }
}